---
const { current } = Astro.props as { current: 'projects' | 'docs' }
const links = [
  { href: '/', label: 'Proyectos', id: 'projects' },
  { href: '/docs/', label: 'Documentación', id: 'docs' },
]
---

<header class="sitio-cabecera bg-marca-tinta text-white">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-5 py-3 sm:px-8">
    <a href="/" class="flex items-center gap-3">
      <img src="/favicon.svg" width="44" height="44" alt="" class="rounded-lg" />
      <div>
        <p class="font-display text-2xl leading-none font-extrabold">Dockyard</p>
        <p class="mt-1 text-xs font-medium text-slate-300">Proyectos estudiantiles</p>
      </div>
    </a>
    <nav aria-label="Principal" class="flex gap-1 text-sm font-semibold sm:mr-auto">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.id === current ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2',
              link.id === current ? 'bg-marca text-marca-tinta' : 'text-slate-200 hover:bg-white/10',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-3">
      <div class="hidden text-right sm:block">
        <p class="font-display text-lg leading-none font-bold">Desarrollo de Software</p>
        <p class="mt-1 text-xs font-semibold text-marca">DS3</p>
      </div>
      <img
        src="/marca/ds-insamt.png"
        width="64"
        height="64"
        alt="Emblema de Desarrollo de Software, INSAMT"
      />
    </div>
  </div>
  <div class="cinta-muelle" aria-hidden="true"></div>
</header>
