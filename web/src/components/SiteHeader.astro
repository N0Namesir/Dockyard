---
const { current } = Astro.props as { current: 'projects' | 'docs' }
const links = [
  { href: '/', label: 'Proyectos', id: 'projects' },
  { href: '/docs/', label: 'Documentación', id: 'docs' },
]
---

<header class="border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4 sm:px-8">
    <a href="/" class="flex items-center gap-3">
      <img src="/favicon.svg" width="40" height="40" alt="" class="shadow-sm rounded-xl" />
      <div>
        <p class="text-lg font-extrabold tracking-tight text-slate-900">Dockyard</p>
        <p class="text-xs font-medium text-slate-500">Proyectos estudiantiles</p>
      </div>
    </a>
    <div class="flex items-center gap-6">
      <nav aria-label="Principal" class="flex gap-1 text-sm font-semibold">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={link.id === current ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-2 hover:bg-slate-100',
                link.id === current ? 'bg-cyan-50 text-cyan-800' : 'text-slate-600',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="hidden items-center gap-2 text-sm text-slate-500 sm:flex">
        <span class="size-2 rounded-full bg-emerald-500"></span>
        Uso local
      </div>
    </div>
  </div>
</header>
