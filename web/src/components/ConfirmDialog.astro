---
// Confirmación de un clic para lo que se puede deshacer. La lógica está en scripts/projects/confirm-dialog.ts.
---

<dialog
  id="confirm-dialog"
  aria-labelledby="confirm-dialog-title"
  aria-describedby="confirm-dialog-text"
  closedby="any"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-lg border border-slate-200 bg-white p-6 shadow-xl backdrop:bg-slate-900/50"
>
  <h2 id="confirm-dialog-title" class="text-lg font-bold break-words text-slate-900"></h2>
  <p id="confirm-dialog-text" class="mt-2 text-sm leading-6 break-words text-slate-600"></p>
  <form method="dialog" class="mt-6 flex justify-end gap-3">
    <button
      id="confirm-dialog-cancel"
      type="button"
      class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-marca-tinta hover:text-marca-texto"
    >
      Cancelar
    </button>
    <button
      id="confirm-dialog-confirm"
      value="confirm"
      autofocus
      class="rounded-lg bg-marca px-4 py-2 text-sm font-bold text-marca-tinta hover:bg-marca-fuerte"
    ></button>
  </form>
</dialog>
