---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import FaviconLinks from '../components/FaviconLinks.astro'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Dockyard: administración local de proyectos estudiantiles"
    />
    <FaviconLinks />
    <title>Dockyard · Proyectos</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader current="projects" />

    <main class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8 lg:py-12">
      <section class="mb-8 max-w-2xl">
        <h1 class="font-display text-4xl font-extrabold text-marca-tinta sm:text-5xl">
          Proyectos del aula
        </h1>
        <p class="mt-3 leading-7 text-slate-600">
          Registra entregas, enciende sus contenedores y abre cada proyecto desde un solo lugar.
        </p>
      </section>

      <div
        id="global-message"
        class="mb-6 hidden rounded-md border px-4 py-3 text-sm"
        role="alert"
        aria-live="polite"
      ></div>

      <div class="grid items-start gap-7 xl:grid-cols-[minmax(0,1fr)_23rem]">
        <section class="min-w-0 rounded-lg border border-slate-200 bg-white shadow-sm">
          <div class="flex flex-col gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-lg font-bold text-slate-900">Proyectos registrados</h2>
              <p id="project-count" class="mt-1 text-sm text-slate-500">Cargando…</p>
              <p id="resources-total" class="mt-0.5 text-xs text-slate-600"></p>
            </div>
            <label class="relative block sm:w-72">
              <span class="sr-only">Buscar por nombre o equipo</span>
              <svg
                class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
              <input
                id="search"
                type="search"
                placeholder="Buscar nombre o equipo"
                autocomplete="off"
                class="w-full rounded-md border border-slate-300 bg-slate-50 py-2.5 pl-9 pr-3 text-sm text-slate-900 placeholder:text-slate-400 hover:border-slate-400 focus:border-marca-tinta focus:bg-white"
              />
            </label>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full min-w-[700px] border-collapse text-left text-sm">
              <thead class="bg-slate-50 text-xs text-slate-500">
                <tr>
                  <th class="px-5 py-3 font-semibold">Nombre</th>
                  <th class="px-5 py-3 font-semibold">Equipo</th>
                  <th class="px-5 py-3 font-semibold">Estado</th>
                  <th class="px-5 py-3 font-semibold">Puertos</th>
                  <th class="px-5 py-3 text-right font-semibold">Acciones</th>
                </tr>
              </thead>
              <tbody id="projects" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </section>

        <aside class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="mb-6">
            <h2 class="font-display text-2xl font-bold text-marca-tinta">Registrar proyecto</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">
              El proyecto debe incluir su propio archivo de Docker Compose.
            </p>
          </div>

          <form id="register-form" class="space-y-5" novalidate>
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Equipo</span>
              <input
                name="team"
                required
                maxlength="120"
                placeholder="Ej. Equipo 3"
                class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-400 focus:border-marca-tinta"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Nombre del proyecto</span>
              <input
                name="name"
                required
                maxlength="120"
                placeholder="Ej. Tienda escolar"
                class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-400 focus:border-marca-tinta"
              />
            </label>

            <fieldset>
              <legend class="mb-2 text-sm font-semibold text-slate-700">Origen</legend>
              <div class="grid grid-cols-2 gap-2 rounded-md bg-slate-100 p-1">
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="source" value="git" checked />
                  <span class="block rounded-lg px-3 py-2 text-center text-sm font-semibold text-slate-500 peer-checked:bg-white peer-checked:text-marca-texto peer-checked:shadow-sm">
                    GitHub
                  </span>
                </label>
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="source" value="zip" />
                  <span class="block rounded-lg px-3 py-2 text-center text-sm font-semibold text-slate-500 peer-checked:bg-white peer-checked:text-marca-texto peer-checked:shadow-sm">
                    Archivo ZIP
                  </span>
                </label>
              </div>
            </fieldset>

            <label id="git-field" class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">URL del repositorio</span>
              <input
                name="repoUrl"
                type="url"
                required
                placeholder="https://github.com/equipo/proyecto"
                class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-400 focus:border-marca-tinta"
              />
            </label>

            <label id="zip-field" class="hidden">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Archivo del proyecto</span>
              <input
                name="file"
                type="file"
                accept=".zip,application/zip"
                class="block w-full cursor-pointer rounded-md border border-slate-300 text-sm text-slate-500 file:mr-3 file:border-0 file:bg-slate-100 file:px-3 file:py-2.5 file:font-semibold file:text-slate-700 hover:file:bg-slate-200"
              />
              <span class="mt-1.5 block text-xs text-slate-500">Máximo 200 MB.</span>
            </label>

            <p id="form-error" class="hidden text-sm font-medium text-red-700" role="alert"></p>

            <button
              id="register-button"
              type="submit"
              class="w-full rounded-md bg-marca px-4 py-3 text-sm font-bold text-marca-tinta shadow-sm transition hover:bg-marca-fuerte disabled:cursor-wait disabled:opacity-60"
            >
              Registrar proyecto
            </button>
          </form>
        </aside>
      </div>
    </main>

    <SiteFooter />

    <dialog
      id="remove-dialog"
      aria-labelledby="remove-dialog-title"
      closedby="any"
      class="m-auto w-[calc(100%-2rem)] max-w-md rounded-lg border border-slate-200 bg-white p-6 shadow-xl backdrop:bg-slate-900/50"
    >
      <h2 id="remove-dialog-title" class="text-lg font-bold break-words text-slate-900"></h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">
        Se borran sus contenedores, su código y sus datos. No se puede deshacer.
      </p>
      <form method="dialog" class="mt-4">
        <label for="remove-dialog-input" class="block text-sm font-medium text-slate-700">
          Para confirmar, escribe{' '}
          <span id="remove-dialog-name" class="font-mono font-bold break-all text-slate-900"></span>
        </label>
        <input
          id="remove-dialog-input"
          type="text"
          autofocus
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          class="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900"
        />
        <div class="mt-6 flex justify-end gap-3">
          <button
            id="remove-dialog-cancel"
            type="button"
            class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-marca-tinta hover:text-marca-texto"
          >
            Cancelar
          </button>
          <button
            id="remove-dialog-confirm"
            value="remove"
            disabled
            class="rounded-lg bg-red-700 px-4 py-2 text-sm font-bold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-red-700"
          >
            Eliminar proyecto
          </button>
        </div>
      </form>
    </dialog>

    <script>
      interface Project {
        id: number
        name: string
        team: string
        state: 'running' | 'stopped'
        ports: number[]
        url: string | null
        urls: string[]
        failedServices: string[]
        web: { state: 'ok' | 'error' | 'no-response'; httpStatus?: number } | null
        warnings: string[]
        progress: Progress | null
        sourceType: 'git' | 'zip'
        pendingBuild: boolean
      }

      interface ApiError {
        message?: string
      }

      const projectsBody = document.querySelector<HTMLTableSectionElement>('#projects')!
      const removeDialog = document.querySelector<HTMLDialogElement>('#remove-dialog')!
      const removeDialogTitle = document.querySelector<HTMLElement>('#remove-dialog-title')!
      const removeDialogName = document.querySelector<HTMLElement>('#remove-dialog-name')!
      const removeDialogInput = document.querySelector<HTMLInputElement>('#remove-dialog-input')!
      const removeDialogCancel = document.querySelector<HTMLButtonElement>('#remove-dialog-cancel')!
      const removeDialogConfirm = document.querySelector<HTMLButtonElement>('#remove-dialog-confirm')!
      const projectCount = document.querySelector<HTMLElement>('#project-count')!
      const resourcesTotal = document.querySelector<HTMLElement>('#resources-total')!
      const searchInput = document.querySelector<HTMLInputElement>('#search')!
      const globalMessage = document.querySelector<HTMLElement>('#global-message')!
      const form = document.querySelector<HTMLFormElement>('#register-form')!
      const registerButton = document.querySelector<HTMLButtonElement>('#register-button')!
      const formError = document.querySelector<HTMLElement>('#form-error')!
      const gitField = document.querySelector<HTMLElement>('#git-field')!
      const zipField = document.querySelector<HTMLElement>('#zip-field')!
      const repoInput = form.elements.namedItem('repoUrl') as HTMLInputElement
      const fileInput = form.elements.namedItem('file') as HTMLInputElement

      /** La petición no llegó a responder: la API está caída o el navegador cortó la espera. */
      class ConnectionError extends Error {}

      /** La API respondió con un error. */
      class ApiResponseError extends Error {
        readonly status: number

        constructor(status: number, message: string) {
          super(message)
          this.status = status
        }
      }

      interface ProjectResources {
        cpuPercent: number
        memoryBytes: number
        services: { service: string; cpuPercent: number; memoryBytes: number }[]
      }

      interface Resources {
        memoryLimit: number
        total: { cpuPercent: number; memoryBytes: number }
        projects: Record<string, ProjectResources | undefined>
      }

      interface Progress {
        stage: string
        lines: string[]
        elapsedSeconds: number
      }

      type ProjectAction = 'start' | 'stop' | 'remove' | 'update'

      const REFRESH_INTERVAL_MS = 15_000
      const PROGRESS_INTERVAL_MS = 2_000
      const LOGS_INTERVAL_MS = 3_000
      const RESOURCES_INTERVAL_MS = 10_000

      const CONNECTION_MESSAGE = 'No se puede conectar con Dockyard. Verifica que esté encendido y recarga la página.'
      const RETRY_DELAY_MS = 5_000
      const MAX_CONNECTION_FAILURES = 5

      let projects: Project[] = []
      let loading = true
      let loadFailed = false
      let latestLoad = 0
      let searchTimer: ReturnType<typeof setTimeout> | undefined
      const pendingActions = new Map<number, ProjectAction>()
      /** Registros abiertos por proyecto; null mientras se cargan. */
      const openLogs = new Map<number, string | null>()
      const actionErrors = new Map<number, string>()
      /** Proyectos con la lista de avisos abierta: redibujar la tabla no debe cerrarla. */
      const openWarnings = new Set<number>()
      let pollingProgress = false
      let pollingLogs = false
      let pollingResources = false
      let resources: Resources | null = null
      /** Registros que el docente subió a leer, con su posición: el texto nuevo no debe moverlos. */
      const logsScroll = new Map<number, number>()

      function element<K extends keyof HTMLElementTagNameMap>(
        tag: K,
        classes?: string,
        text?: string,
      ): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag)
        if (classes) node.className = classes
        if (text !== undefined) node.textContent = text
        return node
      }

      async function api<T>(path: string, init?: RequestInit): Promise<T> {
        let response: Response
        try {
          response = await fetch(path, init)
        } catch {
          throw new ConnectionError(CONNECTION_MESSAGE)
        }
        if (!response.ok) {
          let body: ApiError = {}
          try {
            body = (await response.json()) as ApiError
          } catch {
            // La respuesta sin JSON se convierte en un mensaje estable para el docente.
          }
          throw new ApiResponseError(response.status, body.message ?? 'La operación no pudo completarse.')
        }
        if (response.status === 204) return undefined as T
        return response.json() as Promise<T>
      }

      function showGlobalMessage(message: string, kind: 'error' | 'success' | 'warning'): void {
        globalMessage.textContent = message
        globalMessage.className = `mb-6 rounded-md border px-4 py-3 text-sm ${
          kind === 'error'
            ? 'border-red-200 bg-red-50 text-red-800'
            : kind === 'warning'
              ? 'border-amber-300 bg-amber-50 text-amber-900'
              : 'border-emerald-200 bg-emerald-50 text-emerald-800'
        }`
      }

      function render(): void {
        projectsBody.replaceChildren()
        if (loading) {
          projectCount.textContent = 'Cargando…'
        } else if (loadFailed) {
          projectCount.textContent = 'Sin datos'
        } else {
          projectCount.textContent = `${projects.length} ${projects.length === 1 ? 'proyecto' : 'proyectos'}`
        }

        if (loading) {
          const row = element('tr')
          const cell = element('td', 'px-5 py-12 text-center text-slate-500', 'Cargando proyectos…')
          cell.colSpan = 5
          row.append(cell)
          projectsBody.append(row)
          return
        }

        if (loadFailed) {
          const row = element('tr')
          const cell = element('td', 'px-5 py-12 text-center text-slate-500', 'No se pudo cargar la lista de proyectos.')
          cell.colSpan = 5
          row.append(cell)
          projectsBody.append(row)
          return
        }

        if (projects.length === 0) {
          const row = element('tr')
          const message = searchInput.value.trim()
            ? 'No se encontraron proyectos con esa búsqueda.'
            : 'Todavía no hay proyectos registrados.'
          const cell = element('td', 'px-5 py-12 text-center text-slate-500', message)
          cell.colSpan = 5
          row.append(cell)
          projectsBody.append(row)
          return
        }

        for (const project of projects) {
          const row = element('tr', 'text-slate-700 hover:bg-slate-50/70')
          row.append(element('td', 'px-5 py-4 font-bold text-slate-900', project.name))
          row.append(element('td', 'px-5 py-4', project.team))

          // A medio encender, los contenedores que aún arrancan parecerían una falla.
          const starting = isStarting(project)
          const stateCell = element('td', 'px-5 py-4')
          stateCell.append(
            element(
              'span',
              `inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold ${
                starting
                  ? 'bg-amber-100 text-amber-900'
                  : project.state === 'running'
                    ? 'bg-emerald-100 text-emerald-800'
                    : 'bg-slate-200 text-slate-700'
              }`,
              starting ? 'Encendiendo' : project.state === 'running' ? 'Encendido' : 'Apagado',
            ),
          )
          if (!starting && project.pendingBuild) {
            stateCell.append(element('p', 'mt-1 max-w-40 text-xs font-medium text-amber-800', 'Actualizado: se reconstruye al encender'))
          }
          if (!starting && project.failedServices.length > 0) {
            stateCell.append(
              element(
                'p',
                'mt-1 max-w-40 text-xs font-medium text-amber-800',
                `Con fallas: ${project.failedServices.join(', ')}`,
              ),
            )
          }
          if (!starting && project.web) {
            const { state, httpStatus } = project.web
            stateCell.append(
              element(
                'p',
                `mt-1 max-w-40 text-xs font-medium ${state === 'ok' ? 'text-emerald-800' : 'text-amber-800'}`,
                state === 'ok'
                  ? 'La web responde'
                  : state === 'error'
                    ? `La web responde con error ${httpStatus}`
                    : 'La web aún no responde',
              ),
            )
          }
          if (!starting && project.state === 'running') {
            const usage = element('p', 'mt-1 max-w-40 text-xs text-slate-600')
            usage.dataset.resources = String(project.id)
            fillResources(usage, project.id)
            stateCell.append(usage)
          }
          row.append(stateCell)
          const portsCell = element('td', 'px-5 py-4 font-mono text-xs text-slate-600')
          if (project.ports.length === 0) portsCell.textContent = '—'
          project.ports.forEach((port, index) => {
            if (index > 0) portsCell.append(', ')
            const link = element('a', 'text-marca-texto underline hover:text-marca-tinta', String(port))
            link.href = project.urls[index] ?? '#'
            link.target = '_blank'
            link.rel = 'noopener noreferrer'
            portsCell.append(link)
          })
          row.append(portsCell)

          const actionsCell = element('td', 'px-5 py-4')
          const actionStack = element('div', 'flex flex-col items-end gap-2')
          const actions = element('div', 'flex items-center justify-end gap-2')
          const pending = pendingActions.get(project.id)
          const isPending = pending !== undefined || starting
          const pendingLabel = pending === 'stop' ? 'Apagando…' : 'Encendiendo…'
          const action = element(
            'button',
            'rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-marca-tinta hover:text-marca-texto disabled:cursor-wait disabled:opacity-50',
            starting || pending === 'stop'
              ? pendingLabel
              : project.state === 'running' ? 'Apagar' : 'Encender',
          )
          action.type = 'button'
          action.disabled = isPending
          action.addEventListener('click', () => void changeState(project))
          actions.append(action)

          if (!starting && project.state === 'running' && project.url) {
            const open = element(
              'a',
              'rounded-lg bg-marca px-3 py-1.5 text-xs font-bold text-marca-tinta hover:bg-marca-fuerte',
              'Abrir',
            )
            open.href = project.url
            open.target = '_blank'
            open.rel = 'noopener noreferrer'
            actions.append(open)
          }
          const secondaryActions = element('div', 'flex items-center justify-end gap-3 text-xs font-semibold')
          const logsButton = element(
            'button',
            'text-slate-600 underline hover:text-marca-texto',
            openLogs.has(project.id) ? 'Ocultar registro' : 'Ver registro',
          )
          logsButton.type = 'button'
          logsButton.addEventListener('click', () => void toggleLogs(project))
          const removeButton = element(
            'button',
            'text-red-700 underline hover:text-red-900 disabled:cursor-wait disabled:opacity-50',
            pending === 'remove' ? 'Eliminando…' : 'Eliminar',
          )
          removeButton.type = 'button'
          removeButton.disabled = isPending
          removeButton.addEventListener('click', () => void removeProject(project))
          if (project.sourceType === 'git') {
            const update = element(
              'button',
              'text-slate-600 underline hover:text-marca-texto disabled:cursor-not-allowed disabled:no-underline disabled:opacity-50',
              pending === 'update' ? 'Actualizando…' : 'Actualizar',
            )
            update.type = 'button'
            update.disabled = isPending || project.state === 'running'
            if (project.state === 'running') update.title = 'Apaga el proyecto para actualizarlo'
            update.addEventListener('click', () => void updateProject(project))
            secondaryActions.append(update)
          }
          secondaryActions.append(logsButton, removeButton)
          actionStack.append(actions, secondaryActions)

          const actionError = actionErrors.get(project.id)
          if (actionError) {
            actionStack.append(element('p', 'max-w-md whitespace-pre-wrap break-words text-left text-xs text-red-700', actionError))
          }
          actionsCell.append(actionStack)
          row.append(actionsCell)
          projectsBody.append(row)

          if (starting) projectsBody.append(progressRow(project))
          if (project.warnings.length > 0) projectsBody.append(warningsRow(project))
          if (openLogs.has(project.id)) projectsBody.append(logsRow(project))
        }
      }

      function isStarting(project: Project): boolean {
        return pendingActions.get(project.id) === 'start' || project.progress !== null
      }

      function elapsedText(seconds: number): string {
        const minutes = Math.floor(seconds / 60)
        return minutes > 0 ? `Lleva ${minutes} min ${seconds % 60} s` : `Lleva ${seconds} s`
      }

      function fillProgress(row: HTMLElement, progress: Progress | null): void {
        row.querySelector('[data-stage]')!.textContent = progress?.stage || 'Preparando el encendido'
        row.querySelector('[data-elapsed]')!.textContent = progress ? elapsedText(progress.elapsedSeconds) : ''
        const output = row.querySelector<HTMLElement>('pre')!
        output.textContent = progress?.lines.join('\n') ?? ''
        output.classList.toggle('hidden', !progress?.lines.length)
      }

      function progressRow(project: Project): HTMLTableRowElement {
        const row = element('tr')
        row.dataset.progress = String(project.id)
        const cell = element('td', 'bg-slate-50 px-5 py-4')
        cell.colSpan = 5
        const header = element('div', 'flex flex-wrap items-center gap-x-3 gap-y-1 text-sm')
        const spinner = element('span', 'size-3.5 shrink-0 animate-spin rounded-full border-2 border-slate-300 border-t-marca-tinta motion-reduce:animate-none')
        spinner.setAttribute('aria-hidden', 'true')
        const stage = element('p', 'font-bold text-slate-800')
        stage.dataset.stage = ''
        stage.setAttribute('aria-live', 'polite')
        const elapsed = element('p', 'text-xs text-slate-600')
        elapsed.dataset.elapsed = ''
        header.append(spinner, stage, elapsed)
        const output = element('pre', 'mt-2 overflow-hidden whitespace-pre-wrap break-words rounded-lg bg-slate-900 p-3 font-mono text-xs text-slate-100')
        cell.append(header, output)
        row.append(cell)
        fillProgress(row, project.progress)
        return row
      }

      /** Actualiza solo la fila del avance: redibujar la tabla cada 2 s perdería el foco y la selección. */
      async function pollProgress(): Promise<void> {
        const starting = projects.filter(isStarting)
        if (pollingProgress || document.hidden || starting.length === 0) return
        pollingProgress = true
        let finished = false
        try {
          await Promise.all(starting.map(async (project) => {
            const { progress } = await api<{ progress: Progress | null }>(`/api/projects/${project.id}/progress`)
            // Sin petición propia en curso (se recargó la página), nadie más avisaría que terminó.
            if (progress === null && !pendingActions.has(project.id)) finished = true
            project.progress = progress
            const row = projectsBody.querySelector<HTMLElement>(`[data-progress="${project.id}"]`)
            if (row) fillProgress(row, progress)
          }))
        } catch {
          // Se reintenta en la siguiente vuelta: un corte aquí no afecta al encendido.
        } finally {
          pollingProgress = false
        }
        if (finished) void loadProjects(true)
      }

      function cpuText(percent: number): string {
        return percent > 0 && percent < 1 ? 'menos de 1 %' : `${Math.round(percent)} %`
      }

      function bytesText(bytes: number): string {
        return bytes >= 1024 ** 3 ? `${(bytes / 1024 ** 3).toFixed(1)} GB` : `${Math.round(bytes / 1024 ** 2)} MB`
      }

      function fillResources(target: HTMLElement, id: number): void {
        const usage = resources?.projects[id]
        target.textContent = usage ? `CPU ${cpuText(usage.cpuPercent)}, memoria ${bytesText(usage.memoryBytes)}` : ''
        target.title = usage?.services
          .map((service) => `${service.service}: CPU ${cpuText(service.cpuPercent)}, memoria ${bytesText(service.memoryBytes)}`)
          .join('\n') ?? ''
      }

      /** Actualiza solo los textos del consumo, sin redibujar la tabla. */
      async function pollResources(): Promise<void> {
        if (pollingResources || document.hidden) return
        if (!projects.some((project) => project.state === 'running')) {
          resources = null
          resourcesTotal.textContent = ''
          return
        }
        pollingResources = true
        try {
          resources = await api<Resources>('/api/projects/resources')
          const { total, memoryLimit } = resources
          resourcesTotal.textContent = total.memoryBytes > 0
            ? `Los proyectos encendidos usan CPU ${cpuText(total.cpuPercent)} y ${bytesText(total.memoryBytes)} de ${bytesText(memoryLimit)} de memoria de la PC.`
            : ''
          for (const target of projectsBody.querySelectorAll<HTMLElement>('[data-resources]')) {
            fillResources(target, Number(target.dataset.resources))
          }
        } catch {
          // Es un dato de apoyo: si falla, se reintenta sin interrumpir al docente.
          resources = null
          resourcesTotal.textContent = ''
        } finally {
          pollingResources = false
        }
      }

      function warningsRow(project: Project): HTMLTableRowElement {
        const row = element('tr')
        const cell = element('td', 'bg-amber-50 px-5 py-3 text-sm text-amber-900')
        cell.colSpan = 5
        const details = element('details')
        details.open = openWarnings.has(project.id)
        details.addEventListener('toggle', () => {
          if (details.open) openWarnings.add(project.id)
          else openWarnings.delete(project.id)
        })
        const total = project.warnings.length
        details.append(element(
          'summary',
          'cursor-pointer font-semibold',
          `Revisar antes de encender: ${total} ${total === 1 ? 'aviso' : 'avisos'}`,
        ))
        const list = element('ul', 'mt-2 list-disc space-y-1 pl-5 break-words')
        for (const warning of project.warnings) list.append(element('li', '', warning))
        details.append(list)
        cell.append(details)
        row.append(cell)
        return row
      }

      function logsRow(project: Project): HTMLTableRowElement {
        const row = element('tr')
        row.dataset.logs = String(project.id)
        const cell = element('td', 'bg-slate-50 px-5 py-4')
        cell.colSpan = 5
        const header = element('div', 'mb-2 flex items-center justify-between gap-3')
        const title = element('div')
        title.append(element('p', 'text-xs font-bold text-slate-700', `Últimas líneas del registro de ${project.name}`))
        const follows = project.state === 'running' || isStarting(project)
        const live = element('p', 'text-xs text-slate-600')
        live.dataset.live = ''
        title.append(live)
        header.append(title)
        const refresh = element('button', 'text-xs font-semibold text-slate-600 underline hover:text-marca-texto', 'Actualizar')
        refresh.type = 'button'
        refresh.addEventListener('click', () => void loadLogs(project))
        if (!follows) header.append(refresh)
        const logs = openLogs.get(project.id)
        const output = element(
          'pre',
          'max-h-80 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-slate-900 p-3 font-mono text-xs text-slate-100',
          logs === null ? 'Cargando…' : logs?.trim() || 'Este proyecto todavía no tiene registro.',
        )
        const showLive = () => {
          live.textContent = !follows ? '' : logsScroll.has(project.id)
            ? 'En pausa mientras lees. Baja hasta el final para seguir.'
            : 'Se actualiza solo.'
        }
        showLive()
        output.addEventListener('scroll', () => {
          if (output.scrollHeight - output.scrollTop - output.clientHeight < 8) logsScroll.delete(project.id)
          else logsScroll.set(project.id, output.scrollTop)
          showLive()
        })
        cell.append(header, output)
        row.append(cell)
        // Lo más reciente queda al final, salvo que el docente haya subido a leer.
        requestAnimationFrame(() => { output.scrollTop = logsScroll.get(project.id) ?? output.scrollHeight })
        return row
      }

      /** Trae el registro de los proyectos encendidos con el registro abierto. No toca lo que el docente está leyendo. */
      async function pollLogs(): Promise<void> {
        const open = projects.filter((project) => typeof openLogs.get(project.id) === 'string'
          && (project.state === 'running' || isStarting(project)))
        if (pollingLogs || document.hidden || open.length === 0) return
        pollingLogs = true
        try {
          await Promise.all(open.map(async (project) => {
            const { logs } = await api<{ logs: string }>(`/api/projects/${project.id}/logs`)
            if (!openLogs.has(project.id) || openLogs.get(project.id) === logs) return
            openLogs.set(project.id, logs)
            const output = projectsBody.querySelector<HTMLElement>(`[data-logs="${project.id}"] pre`)
            if (!output || logsScroll.has(project.id) || isSelectingIn(output)) return
            output.textContent = logs.trim() || 'Este proyecto todavía no tiene registro.'
            output.scrollTop = output.scrollHeight
          }))
        } catch {
          // Se reintenta en la siguiente vuelta; el registro en pantalla sigue siendo válido.
        } finally {
          pollingLogs = false
        }
      }

      function isSelectingIn(target: HTMLElement): boolean {
        const selection = document.getSelection()
        return selection !== null && !selection.isCollapsed && selection.containsNode(target, true)
      }

      async function loadLogs(project: Project): Promise<void> {
        openLogs.set(project.id, null)
        render()
        let text: string
        try {
          text = (await api<{ logs: string }>(`/api/projects/${project.id}/logs`)).logs
        } catch (error) {
          text = error instanceof Error ? error.message : 'No se pudo leer el registro.'
        }
        // Pudo cerrarse mientras se cargaba.
        if (openLogs.has(project.id)) {
          openLogs.set(project.id, text)
          render()
        }
      }

      async function toggleLogs(project: Project): Promise<void> {
        if (openLogs.has(project.id)) {
          openLogs.delete(project.id)
          logsScroll.delete(project.id)
          render()
          return
        }
        await loadLogs(project)
      }

      /**
       * Devuelve true si la lista se cargó. Una respuesta que ya no es la última se descarta.
       * Con silent no muestra "Cargando" ni redibuja si nada cambió: es el refresco automático.
       */
      async function loadProjects(silent = false): Promise<boolean> {
        const load = ++latestLoad
        const wasFailed = loadFailed
        if (!silent) {
          loading = true
          render()
        }
        let result: Project[] | undefined
        let message = ''
        try {
          const query = searchInput.value.trim()
          result = await api<Project[]>(`/api/projects${query ? `?q=${encodeURIComponent(query)}` : ''}`)
        } catch (error) {
          message = error instanceof Error ? error.message : CONNECTION_MESSAGE
        }
        if (load !== latestLoad) return false

        const unchanged = silent && !wasFailed && result !== undefined
          && JSON.stringify(result) === JSON.stringify(projects)
        loading = false
        loadFailed = result === undefined
        projects = result ?? []
        // El refresco no borra un aviso de éxito; solo el error que él mismo vino a resolver.
        if (!result) showGlobalMessage(message, 'error')
        else if (!silent || wasFailed) globalMessage.classList.add('hidden')
        if (!unchanged) render()
        return result !== undefined
      }

      /**
       * Firefox corta las peticiones pendientes cuando cambian las redes de la PC, y encender un
       * proyecto crea una red de Docker. El servidor sigue trabajando, así que se repite la
       * petición: la API la une a la operación en curso y responde con su resultado real.
       */
      async function requestWithRetries<T>(path: string, method: string, afterCut?: (error: unknown) => T | undefined): Promise<T> {
        let wasCut = false
        for (let failures = 1; ; failures++) {
          try {
            return await api<T>(path, { method })
          } catch (error) {
            if (wasCut && afterCut) {
              const result = afterCut(error)
              if (result !== undefined) return result
            }
            if (!(error instanceof ConnectionError) || failures >= MAX_CONNECTION_FAILURES) throw error
            wasCut = true
            await new Promise((done) => setTimeout(done, RETRY_DELAY_MS))
          }
        }
      }

      async function changeState(project: Project): Promise<void> {
        if (pendingActions.has(project.id)) return
        const action = project.state === 'running' ? 'stop' : 'start'
        pendingActions.set(project.id, action)
        actionErrors.delete(project.id)
        render()
        try {
          const updated = await requestWithRetries<Project>(`/api/projects/${project.id}/${action}`, 'POST')
          projects = projects.map((item) => item.id === updated.id ? updated : item)
        } catch (error) {
          actionErrors.set(
            project.id,
            error instanceof Error ? error.message : 'No se pudo cambiar el estado.',
          )
          // Una respuesta de error no trae el proyecto: sin esto seguiría figurando como encendiéndose.
          projects = projects.map((item) => item.id === project.id ? { ...item, progress: null } : item)
        } finally {
          pendingActions.delete(project.id)
          render()
        }
      }

      async function updateProject(project: Project): Promise<void> {
        if (pendingActions.has(project.id)) return
        pendingActions.set(project.id, 'update')
        actionErrors.delete(project.id)
        render()
        try {
          const { project: updated, changed, commit, summary } = await requestWithRetries<{
            project: Project
            changed: boolean
            commit: string
            summary: string
          }>(`/api/projects/${project.id}/update`, 'POST')
          projects = projects.map((item) => item.id === updated.id ? updated : item)
          const total = updated.warnings.length
          if (!changed) showGlobalMessage(`${updated.name} ya estaba al día (${commit}: ${summary}).`, 'success')
          else if (total > 0) showGlobalMessage(`${updated.name} se actualizó a ${commit}: ${summary}. La versión nueva tiene ${total} ${total === 1 ? 'aviso' : 'avisos'}: revísalos antes de encender.`, 'warning')
          else showGlobalMessage(`${updated.name} se actualizó a ${commit}: ${summary}. Enciéndelo para ver los cambios.`, 'success')
        } catch (error) {
          actionErrors.set(project.id, error instanceof Error ? error.message : 'No se pudo actualizar.')
        } finally {
          pendingActions.delete(project.id)
          render()
        }
      }

      // Eliminar no se puede deshacer: solo se habilita al escribir el nombre exacto del proyecto.
      function confirmRemoval(name: string): Promise<boolean> {
        removeDialogTitle.textContent = `¿Eliminar ${name}?`
        removeDialogName.textContent = name
        removeDialogInput.value = ''
        removeDialogConfirm.disabled = true
        // Esc y el clic afuera no fijan un valor: sin esto valdría la respuesta anterior.
        removeDialog.returnValue = ''
        removeDialog.showModal()
        return new Promise((resolve) => {
          removeDialog.addEventListener('close', () => resolve(removeDialog.returnValue === 'remove'), {
            once: true,
          })
        })
      }

      removeDialogInput.addEventListener('input', () => {
        removeDialogConfirm.disabled = removeDialogInput.value !== removeDialogName.textContent
      })
      removeDialogCancel.addEventListener('click', () => removeDialog.close())

      async function removeProject(project: Project): Promise<void> {
        if (pendingActions.has(project.id)) return
        if (!(await confirmRemoval(project.name))) return
        pendingActions.set(project.id, 'remove')
        actionErrors.delete(project.id)
        render()
        try {
          // Borrar quita una red, y Firefox puede cortar la petición: un 404 tras el corte es que ya terminó.
          await requestWithRetries<true>(`/api/projects/${project.id}`, 'DELETE', (error) =>
            error instanceof ApiResponseError && error.status === 404 ? true : undefined,
          )
          projects = projects.filter((item) => item.id !== project.id)
          openLogs.delete(project.id)
          showGlobalMessage(`Se eliminó ${project.name}.`, 'success')
        } catch (error) {
          actionErrors.set(
            project.id,
            error instanceof Error ? error.message : 'No se pudo eliminar el proyecto.',
          )
        } finally {
          pendingActions.delete(project.id)
          render()
        }
      }

      function selectedSource(): 'git' | 'zip' {
        const selected = form.querySelector<HTMLInputElement>('input[name="source"]:checked')
        return selected?.value === 'zip' ? 'zip' : 'git'
      }

      function updateSourceFields(): void {
        const isGit = selectedSource() === 'git'
        gitField.classList.toggle('hidden', !isGit)
        zipField.classList.toggle('hidden', isGit)
        repoInput.required = isGit
        fileInput.required = !isGit
      }

      form.addEventListener('change', (event) => {
        const target = event.target as HTMLInputElement
        if (target.name === 'source') updateSourceFields()
      })

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        formError.classList.add('hidden')
        globalMessage.classList.add('hidden')
        if (!form.reportValidity()) return

        const formData = new FormData(form)
        registerButton.disabled = true
        registerButton.textContent = 'Registrando…'

        try {
          let init: RequestInit
          if (selectedSource() === 'git') {
            init = {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                team: formData.get('team'),
                name: formData.get('name'),
                repoUrl: formData.get('repoUrl'),
              }),
            }
          } else {
            const upload = new FormData()
            upload.set('team', String(formData.get('team') ?? ''))
            upload.set('name', String(formData.get('name') ?? ''))
            const file = formData.get('file')
            if (file instanceof File) upload.set('file', file)
            init = { method: 'POST', body: upload }
          }

          const created = await api<Project>('/api/projects', init)
          form.reset()
          updateSourceFields()
          searchInput.value = ''
          if (await loadProjects()) {
            if (created.warnings.length > 0) {
              showGlobalMessage('El proyecto se registró, pero la revisión encontró avisos. Léelos en su fila antes de encenderlo.', 'warning')
            } else {
              showGlobalMessage('El proyecto se registró correctamente.', 'success')
            }
          }
        } catch (error) {
          formError.textContent = error instanceof Error ? error.message : 'No se pudo registrar el proyecto.'
          formError.classList.remove('hidden')
        } finally {
          registerButton.disabled = false
          registerButton.textContent = 'Registrar proyecto'
        }
      })

      searchInput.addEventListener('input', () => {
        if (searchTimer) clearTimeout(searchTimer)
        searchTimer = setTimeout(() => void loadProjects(), 300)
      })

      // Mantiene al día el estado de los proyectos, por ejemplo si uno se cae solo.
      function refresh(): void {
        if (!document.hidden && !loading) void loadProjects(true)
      }
      setInterval(refresh, REFRESH_INTERVAL_MS)
      setInterval(() => void pollProgress(), PROGRESS_INTERVAL_MS)
      setInterval(() => void pollLogs(), LOGS_INTERVAL_MS)
      setInterval(() => void pollResources(), RESOURCES_INTERVAL_MS)
      document.addEventListener('visibilitychange', refresh)

      updateSourceFields()
      render()
      void loadProjects().then(() => pollResources())
    </script>
  </body>
</html>
