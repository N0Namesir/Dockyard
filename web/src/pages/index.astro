---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import FaviconLinks from '../components/FaviconLinks.astro'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Dockyard: administración local de proyectos estudiantiles"
    />
    <FaviconLinks />
    <title>Dockyard · Proyectos</title>
  </head>
  <body>
    <SiteHeader current="projects" />

    <main class="mx-auto max-w-7xl px-5 py-8 sm:px-8 lg:py-12">
      <section class="mb-8 max-w-2xl">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.18em] text-cyan-700">
          Panel del docente
        </p>
        <h1 class="text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
          Proyectos del aula
        </h1>
        <p class="mt-3 leading-7 text-slate-600">
          Registra entregas, enciende sus contenedores y abre cada proyecto desde un solo lugar.
        </p>
      </section>

      <div
        id="global-message"
        class="mb-6 hidden rounded-xl border px-4 py-3 text-sm"
        role="alert"
        aria-live="polite"
      ></div>

      <div class="grid items-start gap-7 xl:grid-cols-[minmax(0,1fr)_23rem]">
        <section class="min-w-0 rounded-2xl border border-slate-200 bg-white shadow-sm">
          <div class="flex flex-col gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-lg font-bold text-slate-900">Proyectos registrados</h2>
              <p id="project-count" class="mt-1 text-sm text-slate-500">Cargando…</p>
            </div>
            <label class="relative block sm:w-72">
              <span class="sr-only">Buscar por nombre o equipo</span>
              <svg
                class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
              <input
                id="search"
                type="search"
                placeholder="Buscar nombre o equipo"
                autocomplete="off"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2.5 pl-9 pr-3 text-sm text-slate-900 placeholder:text-slate-400 hover:border-slate-400 focus:border-cyan-600 focus:bg-white"
              />
            </label>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full min-w-[700px] border-collapse text-left text-sm">
              <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                  <th class="px-5 py-3 font-semibold">Nombre</th>
                  <th class="px-5 py-3 font-semibold">Equipo</th>
                  <th class="px-5 py-3 font-semibold">Estado</th>
                  <th class="px-5 py-3 font-semibold">Puertos</th>
                  <th class="px-5 py-3 text-right font-semibold">Acciones</th>
                </tr>
              </thead>
              <tbody id="projects" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </section>

        <aside class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
          <div class="mb-6">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700">Nuevo</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900">Registrar proyecto</h2>
            <p class="mt-2 text-sm leading-6 text-slate-500">
              El proyecto debe incluir su propio archivo de Docker Compose.
            </p>
          </div>

          <form id="register-form" class="space-y-5" novalidate>
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Equipo</span>
              <input
                name="team"
                required
                maxlength="120"
                placeholder="Ej. Equipo 3"
                class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-400 focus:border-cyan-600"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Nombre del proyecto</span>
              <input
                name="name"
                required
                maxlength="120"
                placeholder="Ej. Tienda escolar"
                class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-400 focus:border-cyan-600"
              />
            </label>

            <fieldset>
              <legend class="mb-2 text-sm font-semibold text-slate-700">Origen</legend>
              <div class="grid grid-cols-2 gap-2 rounded-xl bg-slate-100 p-1">
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="source" value="git" checked />
                  <span class="block rounded-lg px-3 py-2 text-center text-sm font-semibold text-slate-500 peer-checked:bg-white peer-checked:text-cyan-800 peer-checked:shadow-sm">
                    GitHub
                  </span>
                </label>
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="source" value="zip" />
                  <span class="block rounded-lg px-3 py-2 text-center text-sm font-semibold text-slate-500 peer-checked:bg-white peer-checked:text-cyan-800 peer-checked:shadow-sm">
                    Archivo ZIP
                  </span>
                </label>
              </div>
            </fieldset>

            <label id="git-field" class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">URL del repositorio</span>
              <input
                name="repoUrl"
                type="url"
                required
                placeholder="https://github.com/equipo/proyecto"
                class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-400 focus:border-cyan-600"
              />
            </label>

            <label id="zip-field" class="hidden">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Archivo del proyecto</span>
              <input
                name="file"
                type="file"
                accept=".zip,application/zip"
                class="block w-full cursor-pointer rounded-xl border border-slate-300 text-sm text-slate-500 file:mr-3 file:border-0 file:bg-slate-100 file:px-3 file:py-2.5 file:font-semibold file:text-slate-700 hover:file:bg-slate-200"
              />
              <span class="mt-1.5 block text-xs text-slate-500">Máximo 200 MB.</span>
            </label>

            <p id="form-error" class="hidden text-sm font-medium text-red-700" role="alert"></p>

            <button
              id="register-button"
              type="submit"
              class="w-full rounded-xl bg-cyan-700 px-4 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-800 disabled:cursor-wait disabled:opacity-60"
            >
              Registrar proyecto
            </button>
          </form>
        </aside>
      </div>
    </main>

    <dialog
      id="remove-dialog"
      aria-labelledby="remove-dialog-title"
      closedby="any"
      class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-xl backdrop:bg-slate-900/50"
    >
      <h2 id="remove-dialog-title" class="text-lg font-bold break-words text-slate-900"></h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">
        Se borran sus contenedores, su código y sus datos. No se puede deshacer.
      </p>
      <form method="dialog" class="mt-4">
        <label for="remove-dialog-input" class="block text-sm font-medium text-slate-700">
          Para confirmar, escribe{' '}
          <span id="remove-dialog-name" class="font-mono font-bold break-all text-slate-900"></span>
        </label>
        <input
          id="remove-dialog-input"
          type="text"
          autofocus
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          class="mt-2 w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-900"
        />
        <div class="mt-6 flex justify-end gap-3">
          <button
            id="remove-dialog-cancel"
            type="button"
            class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-cyan-600 hover:text-cyan-800"
          >
            Cancelar
          </button>
          <button
            id="remove-dialog-confirm"
            value="remove"
            disabled
            class="rounded-lg bg-red-700 px-4 py-2 text-sm font-bold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-red-700"
          >
            Eliminar proyecto
          </button>
        </div>
      </form>
    </dialog>

    <script>
      interface Project {
        id: number
        name: string
        team: string
        state: 'running' | 'stopped'
        ports: number[]
        url: string | null
        urls: string[]
        failedServices: string[]
      }

      interface ApiError {
        message?: string
      }

      const projectsBody = document.querySelector<HTMLTableSectionElement>('#projects')!
      const removeDialog = document.querySelector<HTMLDialogElement>('#remove-dialog')!
      const removeDialogTitle = document.querySelector<HTMLElement>('#remove-dialog-title')!
      const removeDialogName = document.querySelector<HTMLElement>('#remove-dialog-name')!
      const removeDialogInput = document.querySelector<HTMLInputElement>('#remove-dialog-input')!
      const removeDialogCancel = document.querySelector<HTMLButtonElement>('#remove-dialog-cancel')!
      const removeDialogConfirm = document.querySelector<HTMLButtonElement>('#remove-dialog-confirm')!
      const projectCount = document.querySelector<HTMLElement>('#project-count')!
      const searchInput = document.querySelector<HTMLInputElement>('#search')!
      const globalMessage = document.querySelector<HTMLElement>('#global-message')!
      const form = document.querySelector<HTMLFormElement>('#register-form')!
      const registerButton = document.querySelector<HTMLButtonElement>('#register-button')!
      const formError = document.querySelector<HTMLElement>('#form-error')!
      const gitField = document.querySelector<HTMLElement>('#git-field')!
      const zipField = document.querySelector<HTMLElement>('#zip-field')!
      const repoInput = form.elements.namedItem('repoUrl') as HTMLInputElement
      const fileInput = form.elements.namedItem('file') as HTMLInputElement

      /** La petición no llegó a responder: la API está caída o el navegador cortó la espera. */
      class ConnectionError extends Error {}

      /** La API respondió con un error. */
      class ApiResponseError extends Error {
        readonly status: number

        constructor(status: number, message: string) {
          super(message)
          this.status = status
        }
      }

      type ProjectAction = 'start' | 'stop' | 'remove'

      const REFRESH_INTERVAL_MS = 15_000

      const CONNECTION_MESSAGE = 'No se puede conectar con Dockyard. Verifica que esté encendido y recarga la página.'
      const RETRY_DELAY_MS = 5_000
      const MAX_CONNECTION_FAILURES = 5

      let projects: Project[] = []
      let loading = true
      let loadFailed = false
      let latestLoad = 0
      let searchTimer: ReturnType<typeof setTimeout> | undefined
      const pendingActions = new Map<number, ProjectAction>()
      /** Registros abiertos por proyecto; null mientras se cargan. */
      const openLogs = new Map<number, string | null>()
      const actionErrors = new Map<number, string>()

      function element<K extends keyof HTMLElementTagNameMap>(
        tag: K,
        classes?: string,
        text?: string,
      ): HTMLElementTagNameMap[K] {
        const node = document.createElement(tag)
        if (classes) node.className = classes
        if (text !== undefined) node.textContent = text
        return node
      }

      async function api<T>(path: string, init?: RequestInit): Promise<T> {
        let response: Response
        try {
          response = await fetch(path, init)
        } catch {
          throw new ConnectionError(CONNECTION_MESSAGE)
        }
        if (!response.ok) {
          let body: ApiError = {}
          try {
            body = (await response.json()) as ApiError
          } catch {
            // La respuesta sin JSON se convierte en un mensaje estable para el docente.
          }
          throw new ApiResponseError(response.status, body.message ?? 'La operación no pudo completarse.')
        }
        if (response.status === 204) return undefined as T
        return response.json() as Promise<T>
      }

      function showGlobalMessage(message: string, kind: 'error' | 'success'): void {
        globalMessage.textContent = message
        globalMessage.className = `mb-6 rounded-xl border px-4 py-3 text-sm ${
          kind === 'error'
            ? 'border-red-200 bg-red-50 text-red-800'
            : 'border-emerald-200 bg-emerald-50 text-emerald-800'
        }`
      }

      function render(): void {
        projectsBody.replaceChildren()
        if (loading) {
          projectCount.textContent = 'Cargando…'
        } else if (loadFailed) {
          projectCount.textContent = 'Sin datos'
        } else {
          projectCount.textContent = `${projects.length} ${projects.length === 1 ? 'proyecto' : 'proyectos'}`
        }

        if (loading) {
          const row = element('tr')
          const cell = element('td', 'px-5 py-12 text-center text-slate-500', 'Cargando proyectos…')
          cell.colSpan = 5
          row.append(cell)
          projectsBody.append(row)
          return
        }

        if (loadFailed) {
          const row = element('tr')
          const cell = element('td', 'px-5 py-12 text-center text-slate-500', 'No se pudo cargar la lista de proyectos.')
          cell.colSpan = 5
          row.append(cell)
          projectsBody.append(row)
          return
        }

        if (projects.length === 0) {
          const row = element('tr')
          const message = searchInput.value.trim()
            ? 'No se encontraron proyectos con esa búsqueda.'
            : 'Todavía no hay proyectos registrados.'
          const cell = element('td', 'px-5 py-12 text-center text-slate-500', message)
          cell.colSpan = 5
          row.append(cell)
          projectsBody.append(row)
          return
        }

        for (const project of projects) {
          const row = element('tr', 'text-slate-700 hover:bg-slate-50/70')
          row.append(element('td', 'px-5 py-4 font-bold text-slate-900', project.name))
          row.append(element('td', 'px-5 py-4', project.team))

          const stateCell = element('td', 'px-5 py-4')
          stateCell.append(
            element(
              'span',
              `inline-flex items-center rounded-full px-2.5 py-1 text-xs font-bold ${
                project.state === 'running'
                  ? 'bg-emerald-100 text-emerald-800'
                  : 'bg-slate-200 text-slate-700'
              }`,
              project.state === 'running' ? 'Encendido' : 'Apagado',
            ),
          )
          if (project.failedServices.length > 0) {
            stateCell.append(
              element(
                'p',
                'mt-1 max-w-40 text-xs font-medium text-amber-800',
                `Con fallas: ${project.failedServices.join(', ')}`,
              ),
            )
          }
          row.append(stateCell)
          const portsCell = element('td', 'px-5 py-4 font-mono text-xs text-slate-600')
          if (project.ports.length === 0) portsCell.textContent = '—'
          project.ports.forEach((port, index) => {
            if (index > 0) portsCell.append(', ')
            const link = element('a', 'text-cyan-800 underline hover:text-cyan-950', String(port))
            link.href = project.urls[index] ?? '#'
            link.target = '_blank'
            link.rel = 'noopener noreferrer'
            portsCell.append(link)
          })
          row.append(portsCell)

          const actionsCell = element('td', 'px-5 py-4')
          const actionStack = element('div', 'flex flex-col items-end gap-2')
          const actions = element('div', 'flex items-center justify-end gap-2')
          const pending = pendingActions.get(project.id)
          const isPending = pending !== undefined
          const pendingLabel = pending === 'stop' ? 'Apagando…' : 'Encendiendo…'
          const action = element(
            'button',
            'rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:border-cyan-600 hover:text-cyan-800 disabled:cursor-wait disabled:opacity-50',
            pending === 'start' || pending === 'stop'
              ? pendingLabel
              : project.state === 'running' ? 'Apagar' : 'Encender',
          )
          action.type = 'button'
          action.disabled = isPending
          action.addEventListener('click', () => void changeState(project))
          actions.append(action)

          if (project.state === 'running' && project.url) {
            const open = element(
              'a',
              'rounded-lg bg-cyan-700 px-3 py-1.5 text-xs font-bold text-white hover:bg-cyan-800',
              'Abrir',
            )
            open.href = project.url
            open.target = '_blank'
            open.rel = 'noopener noreferrer'
            actions.append(open)
          }
          const secondaryActions = element('div', 'flex items-center justify-end gap-3 text-xs font-semibold')
          const logsButton = element(
            'button',
            'text-slate-600 underline hover:text-cyan-800',
            openLogs.has(project.id) ? 'Ocultar registro' : 'Ver registro',
          )
          logsButton.type = 'button'
          logsButton.addEventListener('click', () => void toggleLogs(project))
          const removeButton = element(
            'button',
            'text-red-700 underline hover:text-red-900 disabled:cursor-wait disabled:opacity-50',
            pending === 'remove' ? 'Eliminando…' : 'Eliminar',
          )
          removeButton.type = 'button'
          removeButton.disabled = isPending
          removeButton.addEventListener('click', () => void removeProject(project))
          secondaryActions.append(logsButton, removeButton)
          actionStack.append(actions, secondaryActions)

          const actionError = actionErrors.get(project.id)
          if (actionError) {
            actionStack.append(element('p', 'max-w-md whitespace-pre-wrap break-words text-left text-xs text-red-700', actionError))
          }
          actionsCell.append(actionStack)
          row.append(actionsCell)
          projectsBody.append(row)

          if (openLogs.has(project.id)) projectsBody.append(logsRow(project))
        }
      }

      function logsRow(project: Project): HTMLTableRowElement {
        const row = element('tr')
        const cell = element('td', 'bg-slate-50 px-5 py-4')
        cell.colSpan = 5
        const header = element('div', 'mb-2 flex items-center justify-between gap-3')
        header.append(element('p', 'text-xs font-bold text-slate-700', `Últimas líneas del registro de ${project.name}`))
        const refresh = element('button', 'text-xs font-semibold text-slate-600 underline hover:text-cyan-800', 'Actualizar')
        refresh.type = 'button'
        refresh.addEventListener('click', () => void loadLogs(project))
        header.append(refresh)
        const logs = openLogs.get(project.id)
        const output = element(
          'pre',
          'max-h-80 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-slate-900 p-3 font-mono text-xs text-slate-100',
          logs === null ? 'Cargando…' : logs?.trim() || 'Este proyecto todavía no tiene registro.',
        )
        cell.append(header, output)
        row.append(cell)
        // Lo más reciente queda al final.
        requestAnimationFrame(() => { output.scrollTop = output.scrollHeight })
        return row
      }

      async function loadLogs(project: Project): Promise<void> {
        openLogs.set(project.id, null)
        render()
        let text: string
        try {
          text = (await api<{ logs: string }>(`/api/projects/${project.id}/logs`)).logs
        } catch (error) {
          text = error instanceof Error ? error.message : 'No se pudo leer el registro.'
        }
        // Pudo cerrarse mientras se cargaba.
        if (openLogs.has(project.id)) {
          openLogs.set(project.id, text)
          render()
        }
      }

      async function toggleLogs(project: Project): Promise<void> {
        if (openLogs.has(project.id)) {
          openLogs.delete(project.id)
          render()
          return
        }
        await loadLogs(project)
      }

      /**
       * Devuelve true si la lista se cargó. Una respuesta que ya no es la última se descarta.
       * Con silent no muestra "Cargando" ni redibuja si nada cambió: es el refresco automático.
       */
      async function loadProjects(silent = false): Promise<boolean> {
        const load = ++latestLoad
        const wasFailed = loadFailed
        if (!silent) {
          loading = true
          render()
        }
        let result: Project[] | undefined
        let message = ''
        try {
          const query = searchInput.value.trim()
          result = await api<Project[]>(`/api/projects${query ? `?q=${encodeURIComponent(query)}` : ''}`)
        } catch (error) {
          message = error instanceof Error ? error.message : CONNECTION_MESSAGE
        }
        if (load !== latestLoad) return false

        const unchanged = silent && !wasFailed && result !== undefined
          && JSON.stringify(result) === JSON.stringify(projects)
        loading = false
        loadFailed = result === undefined
        projects = result ?? []
        // El refresco no borra un aviso de éxito; solo el error que él mismo vino a resolver.
        if (!result) showGlobalMessage(message, 'error')
        else if (!silent || wasFailed) globalMessage.classList.add('hidden')
        if (!unchanged) render()
        return result !== undefined
      }

      /**
       * Firefox corta las peticiones pendientes cuando cambian las redes de la PC, y encender un
       * proyecto crea una red de Docker. El servidor sigue trabajando, así que se repite la
       * petición: la API la une a la operación en curso y responde con su resultado real.
       */
      async function requestWithRetries<T>(path: string, method: string, afterCut?: (error: unknown) => T | undefined): Promise<T> {
        let wasCut = false
        for (let failures = 1; ; failures++) {
          try {
            return await api<T>(path, { method })
          } catch (error) {
            if (wasCut && afterCut) {
              const result = afterCut(error)
              if (result !== undefined) return result
            }
            if (!(error instanceof ConnectionError) || failures >= MAX_CONNECTION_FAILURES) throw error
            wasCut = true
            await new Promise((done) => setTimeout(done, RETRY_DELAY_MS))
          }
        }
      }

      async function changeState(project: Project): Promise<void> {
        if (pendingActions.has(project.id)) return
        const action = project.state === 'running' ? 'stop' : 'start'
        pendingActions.set(project.id, action)
        actionErrors.delete(project.id)
        render()
        try {
          const updated = await requestWithRetries<Project>(`/api/projects/${project.id}/${action}`, 'POST')
          projects = projects.map((item) => item.id === updated.id ? updated : item)
        } catch (error) {
          actionErrors.set(
            project.id,
            error instanceof Error ? error.message : 'No se pudo cambiar el estado.',
          )
        } finally {
          pendingActions.delete(project.id)
          render()
        }
      }

      // Eliminar no se puede deshacer: solo se habilita al escribir el nombre exacto del proyecto.
      function confirmRemoval(name: string): Promise<boolean> {
        removeDialogTitle.textContent = `¿Eliminar ${name}?`
        removeDialogName.textContent = name
        removeDialogInput.value = ''
        removeDialogConfirm.disabled = true
        // Esc y el clic afuera no fijan un valor: sin esto valdría la respuesta anterior.
        removeDialog.returnValue = ''
        removeDialog.showModal()
        return new Promise((resolve) => {
          removeDialog.addEventListener('close', () => resolve(removeDialog.returnValue === 'remove'), {
            once: true,
          })
        })
      }

      removeDialogInput.addEventListener('input', () => {
        removeDialogConfirm.disabled = removeDialogInput.value !== removeDialogName.textContent
      })
      removeDialogCancel.addEventListener('click', () => removeDialog.close())

      async function removeProject(project: Project): Promise<void> {
        if (pendingActions.has(project.id)) return
        if (!(await confirmRemoval(project.name))) return
        pendingActions.set(project.id, 'remove')
        actionErrors.delete(project.id)
        render()
        try {
          // Borrar quita una red, y Firefox puede cortar la petición: un 404 tras el corte es que ya terminó.
          await requestWithRetries<true>(`/api/projects/${project.id}`, 'DELETE', (error) =>
            error instanceof ApiResponseError && error.status === 404 ? true : undefined,
          )
          projects = projects.filter((item) => item.id !== project.id)
          openLogs.delete(project.id)
          showGlobalMessage(`Se eliminó ${project.name}.`, 'success')
        } catch (error) {
          actionErrors.set(
            project.id,
            error instanceof Error ? error.message : 'No se pudo eliminar el proyecto.',
          )
        } finally {
          pendingActions.delete(project.id)
          render()
        }
      }

      function selectedSource(): 'git' | 'zip' {
        const selected = form.querySelector<HTMLInputElement>('input[name="source"]:checked')
        return selected?.value === 'zip' ? 'zip' : 'git'
      }

      function updateSourceFields(): void {
        const isGit = selectedSource() === 'git'
        gitField.classList.toggle('hidden', !isGit)
        zipField.classList.toggle('hidden', isGit)
        repoInput.required = isGit
        fileInput.required = !isGit
      }

      form.addEventListener('change', (event) => {
        const target = event.target as HTMLInputElement
        if (target.name === 'source') updateSourceFields()
      })

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        formError.classList.add('hidden')
        globalMessage.classList.add('hidden')
        if (!form.reportValidity()) return

        const formData = new FormData(form)
        registerButton.disabled = true
        registerButton.textContent = 'Registrando…'

        try {
          let init: RequestInit
          if (selectedSource() === 'git') {
            init = {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                team: formData.get('team'),
                name: formData.get('name'),
                repoUrl: formData.get('repoUrl'),
              }),
            }
          } else {
            const upload = new FormData()
            upload.set('team', String(formData.get('team') ?? ''))
            upload.set('name', String(formData.get('name') ?? ''))
            const file = formData.get('file')
            if (file instanceof File) upload.set('file', file)
            init = { method: 'POST', body: upload }
          }

          await api<Project>('/api/projects', init)
          form.reset()
          updateSourceFields()
          searchInput.value = ''
          if (await loadProjects()) {
            showGlobalMessage('El proyecto se registró correctamente.', 'success')
          }
        } catch (error) {
          formError.textContent = error instanceof Error ? error.message : 'No se pudo registrar el proyecto.'
          formError.classList.remove('hidden')
        } finally {
          registerButton.disabled = false
          registerButton.textContent = 'Registrar proyecto'
        }
      })

      searchInput.addEventListener('input', () => {
        if (searchTimer) clearTimeout(searchTimer)
        searchTimer = setTimeout(() => void loadProjects(), 300)
      })

      // Mantiene al día el estado de los proyectos, por ejemplo si uno se cae solo.
      function refresh(): void {
        if (!document.hidden && !loading) void loadProjects(true)
      }
      setInterval(refresh, REFRESH_INTERVAL_MS)
      document.addEventListener('visibilitychange', refresh)

      updateSourceFields()
      render()
      void loadProjects()
    </script>
  </body>
</html>
