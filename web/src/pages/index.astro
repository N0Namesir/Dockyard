---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import FaviconLinks from '../components/FaviconLinks.astro'
import ConfirmDialog from '../components/ConfirmDialog.astro'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Dockyard: administración local de proyectos estudiantiles"
    />
    <FaviconLinks />
    <title>Dockyard · Proyectos</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#contenido">Saltar a los proyectos</a>
    <SiteHeader current="projects" />

    <main id="contenido" tabindex="-1" class="mx-auto w-full max-w-7xl px-5 py-8 sm:px-8 lg:py-12">
      <section class="page-heading">
        <div>
          <h1 class="text-3xl font-bold text-marca-tinta sm:text-4xl">
            Proyectos del aula
          </h1>
          <p class="mt-3 leading-7 text-slate-600">
            Administra las entregas y abre los proyectos de tus equipos.
          </p>
        </div>
        <button id="open-register" type="button" class="ui-button ui-button-primary" aria-haspopup="dialog">+ Registrar proyecto</button>
      </section>

      <div
        id="global-message"
        class="mb-6 hidden rounded-md border px-4 py-3 text-sm"
        role="alert"
        aria-live="polite"
      ></div>

      <p id="registration-status" role="status" class="registration-status"></p>

      <p id="version-notice" class="mb-6 hidden rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        Hay una versión nueva de Dockyard: <strong id="version-latest"></strong> (tienes <span id="version-current"></span>).
        <a href="/configuracion/" class="font-bold underline">Instálala desde Configuración</a>.
      </p>

      <div class="grid grid-cols-12 items-start gap-y-5 lg:gap-x-7">
        <nav id="folders" aria-label="Carpetas por año" class="folders col-span-12 min-w-0 lg:col-span-2">
          <h2 class="sr-only">Carpetas por año</h2>
          <ul id="folder-list" class="flex gap-2 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible"></ul>
        </nav>
        <section class="col-span-12 min-w-0 rounded-lg border border-slate-200 bg-white shadow-sm lg:col-span-10">
          <div class="flex flex-col gap-4 border-b border-slate-200 p-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 id="projects-title" class="text-lg font-bold text-slate-900">Proyectos registrados</h2>
              <p id="project-count" class="mt-1 text-sm text-slate-500">Cargando…</p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-end">
              <div role="group" aria-label="Vista" class="view-toggle flex shrink-0 rounded-lg border border-slate-300 bg-slate-50 p-0.5">
                <button id="view-table" type="button" data-view="table" aria-pressed="false" class="view-option">Tabla</button>
                <button id="view-grid" type="button" data-view="grid" aria-pressed="false" class="view-option">Cuadrícula</button>
              </div>
              <button
                id="stop-all"
                type="button"
                hidden
                class="min-h-11 shrink-0 whitespace-nowrap rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-bold text-slate-700 hover:border-marca-tinta hover:text-marca-texto disabled:cursor-wait disabled:opacity-50"
              >
                Apagar todos
              </button>
              <label class="relative block sm:w-72">
                <span class="sr-only">Buscar por nombre o equipo</span>
                <svg
                  class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-3.5-3.5"></path>
                </svg>
                <input
                  id="search"
                  type="search"
                  placeholder="Buscar nombre o equipo"
                  autocomplete="off"
                  class="w-full rounded-md border border-slate-300 bg-slate-50 py-2.5 pl-9 pr-3 text-sm text-slate-900 placeholder:text-slate-500 hover:border-slate-400 focus:border-marca-tinta focus:bg-white"
                />
              </label>
            </div>
          </div>

          <div id="projects-area">
          <div id="projects-table-wrap" class="overflow-x-auto">
            <table aria-label="Proyectos registrados" class="projects-table w-full border-collapse text-left text-sm">
              <thead class="bg-slate-50 text-sm text-slate-600">
                <tr>
                  <th class="px-5 py-3 font-semibold">Nombre</th>
                  <th class="px-5 py-3 font-semibold">Equipo</th>
                  <th class="px-5 py-3 font-semibold">Estado</th>
                  <th class="px-5 py-3 font-semibold">Puertos</th>
                  <th class="px-5 py-3 text-right font-semibold">Acciones</th>
                </tr>
              </thead>
              <tbody id="projects" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
          <div id="projects-grid" hidden class="grid grid-cols-12 gap-5 p-5"></div>
          </div>
          <p id="resources-total" class="resource-summary text-sm text-slate-600"></p>
        </section>
      </div>
    </main>

    <SiteFooter />

    <dialog id="register-dialog" aria-labelledby="register-title" class="register-panel">
          <div class="mb-6">
            <div class="flex items-center justify-between gap-4"><h2 id="register-title" class="text-2xl font-bold text-marca-tinta">Registrar proyecto</h2><button id="close-register" type="button" class="ui-button" aria-label="Cerrar registro">Cerrar</button></div>
            <p class="mt-2 text-sm leading-6 text-slate-500">
              Usa un repositorio público de GitHub o un archivo ZIP con su Docker Compose.
            </p>
          </div>

          <form id="register-form" class="space-y-5" novalidate>
            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Equipo</span>
              <input
                name="team"
                required
                maxlength="120"
                placeholder="Ej. Equipo 3"
                class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-500 focus:border-marca-tinta"
              />
            </label>

            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Nombre del proyecto</span>
              <input
                name="name"
                required
                maxlength="120"
                placeholder="Ej. Tienda escolar"
                aria-describedby="register-name-hint"
                class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-500 focus:border-marca-tinta"
              />
              <span id="register-name-hint" class="mt-1.5 block text-xs text-slate-500">Se muestra tal cual. Docker y la carpeta usan una versión en minúsculas y con guiones.</span>
            </label>
            <input type="hidden" name="displayName" />

            <label class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Año</span>
              <input
                name="year"
                type="number"
                required
                min="2000"
                max="2100"
                step="1"
                class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm focus:border-marca-tinta"
              />
            </label>

            <fieldset>
              <legend class="mb-2 text-sm font-semibold text-slate-700">Origen</legend>
              <div class="grid grid-cols-2 gap-2 rounded-md bg-slate-100 p-1">
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="source" value="git" checked />
                  <span class="block rounded-lg px-3 py-2 text-center text-sm font-semibold text-slate-500 peer-focus-visible:outline peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-marca-acento peer-checked:bg-white peer-checked:text-marca-texto peer-checked:shadow-sm">
                    GitHub
                  </span>
                </label>
                <label class="cursor-pointer">
                  <input class="peer sr-only" type="radio" name="source" value="zip" />
                  <span class="block rounded-lg px-3 py-2 text-center text-sm font-semibold text-slate-500 peer-focus-visible:outline peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-marca-acento peer-checked:bg-white peer-checked:text-marca-texto peer-checked:shadow-sm">
                    Archivo ZIP
                  </span>
                </label>
              </div>
            </fieldset>

            <label id="git-field" class="block">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">URL del repositorio</span>
              <input
                name="repoUrl"
                type="url"
                required
                placeholder="https://github.com/equipo/proyecto"
                class="w-full rounded-md border border-slate-300 px-3.5 py-2.5 text-sm placeholder:text-slate-500 focus:border-marca-tinta"
              />
            </label>

            <label id="zip-field" class="hidden">
              <span class="mb-1.5 block text-sm font-semibold text-slate-700">Archivo del proyecto</span>
              <input
                name="file"
                type="file"
                accept=".zip,application/zip"
                class="block w-full cursor-pointer rounded-md border border-slate-300 text-sm text-slate-500 file:mr-3 file:border-0 file:bg-slate-100 file:px-3 file:py-2.5 file:font-semibold file:text-slate-700 hover:file:bg-slate-200"
              />
              <span class="mt-1.5 block text-xs text-slate-500">Máximo 200 MB.</span>
            </label>

            <p id="register-feedback" class="text-sm text-marca-acento" role="status"></p>
            <p id="form-error" class="hidden text-sm font-medium text-red-700" role="alert"></p>
            <button id="use-suggestion" type="button" hidden class="ui-button w-full"></button>

            <button
              id="register-button"
              type="submit"
              class="w-full rounded-md bg-marca px-4 py-3 text-sm font-bold text-marca-tinta shadow-sm transition hover:bg-marca-fuerte disabled:cursor-wait disabled:opacity-60"
            >
              Registrar proyecto
            </button>
            <label class="flex items-center gap-2 text-sm text-slate-600"><input id="register-another" type="checkbox" class="size-4 accent-marca-tinta" /> Seguir registrando proyectos</label>
          </form>

    </dialog>

    <dialog
      id="remove-dialog"
      aria-labelledby="remove-dialog-title"
      closedby="any"
      class="m-auto w-[calc(100%-2rem)] max-w-md rounded-lg border border-slate-200 bg-white p-6 shadow-xl backdrop:bg-slate-900/50"
    >
      <h2 id="remove-dialog-title" class="text-lg font-bold break-words text-slate-900"></h2>
      <p id="remove-dialog-text" class="mt-2 text-sm leading-6 break-words text-slate-600"></p>
      <form method="dialog" class="mt-4">
        <label for="remove-dialog-input" class="block text-sm font-medium text-slate-700">
          Para confirmar, escribe{' '}
          <span id="remove-dialog-name" class="font-mono font-bold break-all text-slate-900"></span>
        </label>
        <input
          id="remove-dialog-input"
          type="text"
          autofocus
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          class="mt-2 w-full rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900"
        />
        <div class="mt-6 flex justify-end gap-3">
          <button
            id="remove-dialog-cancel"
            type="button"
            class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-marca-tinta hover:text-marca-texto"
          >
            Cancelar
          </button>
          <button
            id="remove-dialog-confirm"
            value="remove"
            disabled
            class="rounded-lg bg-red-700 px-4 py-2 text-sm font-bold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-red-700"
          ></button>
        </div>
      </form>
    </dialog>

    <ConfirmDialog />

    <script>
      // La lógica de la página vive en src/scripts/projects/, un módulo por tarea.
      import '../scripts/projects/main.ts'
    </script>
  </body>
</html>
