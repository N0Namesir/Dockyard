{
  "name": "@dockyard/core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Área 1: núcleo que obtiene el código de los proyectos y los controla con docker compose",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "try": "node src/try.ts",
    "test": "node --test test/unit.test.ts",
    "test:docker": "node --test --test-concurrency=1 test/docker.test.ts"
  }
}
